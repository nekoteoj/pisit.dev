<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not Found - Pisit</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="flex flex-col items-center justify-center p-8 bg-white dark:bg-slate-900 rounded-xl border border-gray-100 dark:border-slate-800 shadow-sm max-w-md mx-auto mt-12 text-center transition-colors duration-300">
                <h2 class="text-4xl font-bold text-accent-5 dark:text-accent-3 mb-2">404</h2>
                <h3 class="text-xl font-bold text-slate-800 dark:text-slate-100 mb-4">Page Not Found</h3>
                <p class="text-slate-600 dark:text-slate-300 mb-6">Sorry, there's nothing at this address.</p>
                <a href="" class="px-5 py-2.5 bg-accent-5 hover:bg-accent-3 text-white rounded-full font-medium transition duration-150 shadow-sm hover:scale-[1.02] cursor-pointer">
                    Go Back Home
                </a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
