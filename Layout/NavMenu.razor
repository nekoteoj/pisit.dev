<nav class="w-dvw bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-gray-100 dark:border-slate-800/80 shadow-sm sticky top-0 z-50 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <!-- Left: Logo / Site Name -->
            <div class="flex-shrink-0 flex">
                <NavLink href="">
                    <img src="icon/nekoteoj_logo.webp" alt="pisit.dev logo"
                        class="h-13 drop-shadow-sm drop-shadow-pink-300/50">
                </NavLink>
            </div>

            <!-- Hamburger menu button (mobile) -->
            <div class="md:hidden flex">
                <button id="menu-toggle" @onclick="ToggleNavMenu"
                    aria-expanded="@((!collapseNavMenu).ToString().ToLower())"
                    aria-label="Toggle navigation menu"
                    class="p-2 text-accent-5 focus:outline-none rounded-full hover:bg-gray-200 dark:hover:bg-slate-800 cursor-pointer">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>

            <!-- Right: Navigation Links -->
            <div class="hidden md:flex space-x-2 items-center h-full text-slate-700 dark:text-slate-200">
                <NavLink
                    class="inline-flex items-center rounded-full hover:bg-gray-200 dark:hover:bg-slate-800 transition duration-150 py-2 px-4"
                    href="" Match="NavLinkMatch.All" ActiveClass="bg-accent-1 text-accent-5 dark:bg-accent-5/20 dark:text-accent-3">Home</NavLink>
                <NavLink
                    class="inline-flex items-center rounded-full hover:bg-gray-200 dark:hover:bg-slate-800 transition duration-150 py-2 px-4"
                    href="/research" Match="NavLinkMatch.All" ActiveClass="bg-accent-1 text-accent-5 dark:bg-accent-5/20 dark:text-accent-3">Research</NavLink>
                <NavLink
                    class="inline-flex items-center rounded-full hover:bg-gray-200 dark:hover:bg-slate-800 transition duration-150 py-2 px-4"
                    href="/blog" Match="NavLinkMatch.All" ActiveClass="bg-accent-1 text-accent-5 dark:bg-accent-5/20 dark:text-accent-3">Blog</NavLink>
            </div>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div
        class="absolute md:hidden @NavMenuCssClass overflow-hidden bg-white dark:bg-slate-900 border-b border-gray-100 dark:border-slate-800 shadow-md w-full transition-all duration-250 ease-in-out z-50">
        <div class="px-4 py-4 space-y-2 border-b-4 border-accent-3 dark:border-accent-5/50 text-slate-700 dark:text-slate-200">
            <NavLink class="flex py-2 justify-center rounded-full hover:bg-gray-200 dark:hover:bg-slate-800" href="" Match="NavLinkMatch.All"
                ActiveClass="bg-accent-1 text-accent-5 dark:bg-accent-5/20 dark:text-accent-3" @onclick="CloseNavMenu">Home
            </NavLink>
            <NavLink class="flex py-2 justify-center rounded-full hover:bg-gray-200 dark:hover:bg-slate-800" href="/research"
                Match="NavLinkMatch.All" ActiveClass="bg-accent-1 text-accent-5 dark:bg-accent-5/20 dark:text-accent-3" @onclick="CloseNavMenu">Research
            </NavLink>
            <NavLink class="flex py-2 justify-center rounded-full hover:bg-gray-200 dark:hover:bg-slate-800" href="/blog"
                Match="NavLinkMatch.All" ActiveClass="bg-accent-1 text-accent-5 dark:bg-accent-5/20 dark:text-accent-3" @onclick="CloseNavMenu">Blog
            </NavLink>
        </div>
    </div>
</nav>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "max-h-0" : "max-h-64";

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void CloseNavMenu()
    {
        collapseNavMenu = true;
    }
}
