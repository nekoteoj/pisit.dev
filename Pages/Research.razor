@page "/research"
@using PisitDev.Models
@inject PisitDev.Services.PublicationService PublicationService

<PageTitle>Research - Pisit</PageTitle>

<div class="flex flex-col justify-center items-center gap-y-4">
    <section
        class="flex flex-col w-full h-fit md:max-w-4xl gap-x-4 rounded-xl bg-white p-6 shadow-md outline-1 outline-black/10 dark:bg-slate-800 dark:shadow-none dark:-outline-offset-1 dark:outline-white/10">
        <h1 class="font-bold text-xl">Publication</h1>
        <hr class="my-4 border-gray-200 w-full">
        <ul class="list-disc space-y-4">
            @foreach (var pub in PublicationService.GetPublications().Where(p => !p.IsConference))
            {
                <li class="ml-4">
                    <p class="font-bold">@pub.Title</p>
                    <p>@((MarkupString)HighlightAuthor(pub.FormattedAuthors, "Pisit Wajanasara"))</p>
                    <p>
                        [@pub.Year] @pub.Venue
                        @if (!string.IsNullOrEmpty(pub.PaperUrl))
                        {
                            <a href="@pub.PaperUrl" target="_blank" class="text-accent-5 ml-1 hover:underline">&lt;paper&gt;</a>
                        }
                        @if (!string.IsNullOrEmpty(pub.CodeUrl))
                        {
                            <a href="@pub.CodeUrl" target="_blank" class="text-accent-5 ml-1 hover:underline">&lt;code&gt;</a>
                        }
                    </p>
                </li>
            }
        </ul>
    </section>

    <section
        class="flex flex-col w-full h-fit md:max-w-4xl gap-x-4 rounded-xl bg-white p-6 shadow-md outline-1 outline-black/10 dark:bg-slate-800 dark:shadow-none dark:-outline-offset-1 dark:outline-white/10">
        <h1 class="font-bold text-xl">Conference</h1>
        <hr class="my-4 border-gray-200 w-full">
        <ul class="list-disc space-y-4">
            @foreach (var pub in PublicationService.GetPublications().Where(p => p.IsConference))
            {
                <li class="ml-4">
                    <p class="font-bold">@pub.Title</p>
                    <p>@((MarkupString)HighlightAuthor(pub.FormattedAuthors, "Pisit Wajanasara"))</p>
                    <p>[@pub.Year] @pub.Venue</p>
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private string HighlightAuthor(string authors, string nameToHighlight)
    {
        return authors.Replace(nameToHighlight, $"<span class=\"underline\">{nameToHighlight}</span>");
    }
}
